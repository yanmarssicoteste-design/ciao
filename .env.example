# Copie este arquivo para ".env" e preencha com os dados do SEU projeto Firebase.
# Onde encontrar: console.firebase.google.com > seu projeto > ⚙️ Configurações do projeto
# > Geral > "Seus apps" > app Web > SDK setup and configuration

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
