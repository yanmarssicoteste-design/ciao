{
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      { "source": "/loja/**", "destination": "/loja.html" },
      { "source": "/admin/**", "destination": "/admin.html" }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
